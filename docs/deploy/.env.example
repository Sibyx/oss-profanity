# IP-010: production worker env template — copy to /opt/oss-profanity/.env
# on each of the three faculty worker hosts, fill in GITHUB_TOKEN, then chmod
# 600 the resulting file.
#
# Every variable is documented in docs/CONFIGURATION.md.

# ---------- MongoDB ----------

# Mongo host on the faculty private network. Update the IP if the operator
# ever binds Mongo to a different interface.
MONGO_URI=mongodb://10.150.104.106:27017/profanity

# ---------- Worker pool (IP-007) ----------

# 12 multiprocessing workers per host × 3 hosts = 36 concurrent (DRAFT target).
# Leaves ~4 vCPU headroom on the 16-vCPU host for git clones and subprocess
# analyzers.
WORKER_CONCURRENCY=12

# Where IP-007 clones repos. Points at the Docker named `scratch` volume
# declared in compose.yml.
SCRATCH_DIR=/scratch

# Hard cap per repo in Stage 4 (IP-007); exceeds → status=failed.
PER_REPO_TIMEOUT_SEC=600

# Skip repos reported larger than this pre-clone (IP-007).
MAX_REPO_SIZE_MB=2048

# Stale-claim TTL. A claim older than this flips back to pending on the next
# reclaim_stale() call — handles crashed workers.
STALE_CLAIM_TTL_MIN=20

# ---------- GitHub REST (IP-007) ----------

# 60/h unauth is not enough; a fine-grained PAT raises the limit to 5000/h.
# See docs/CONFIGURATION.md for the PAT creation steps. After editing this
# file, run `chmod 600 /opt/oss-profanity/.env`.
GITHUB_TOKEN=github_pat_replace_me

# Sent on every GitHub API call so Cloudflare / GitHub abuse team can
# identify us. Update the email to your contact if you fork.
GITHUB_USER_AGENT=oss-profanity/0.1 (jakub.dubec@stuba.sk)
