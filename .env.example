# Copy to `.env` and tune for your setup. Committed to git as documentation;
# the real `.env` (which is .gitignored) may override anything here.
#
# `python-dotenv` loads this file at import time of
# `oss_profanity.config`. Real environment variables always win over `.env`
# — this file is for developer ergonomics, not production secret management.

# ---------- MongoDB ----------

# Local native install (Homebrew / apt / mongod --dbpath):
# MONGO_URI=mongodb://localhost:27017/profanity
#
# Local docker-compose (see compose.yml — ports 27019:27017).
# 27018 is reserved for the SSH tunnel to production — do not use it here.
# MONGO_URI=mongodb://localhost:27019/profanity
#
# OpenStack deployment (IP-010, binds to internal IP):
# MONGO_URI=mongodb://10.150.104.106:27017/profanity
MONGO_URI=mongodb://localhost:27017/profanity

# ---------- Ingest window ----------

# Full experiment window — 744 hourly files, ~50 GB compressed, 5-7 h on
# the `jd-profanity-mogo` 8-vCPU ingest host. For local smoke-testing,
# narrow to a single hour (GHA_START=GHA_END=2020-06-01-00) or a
# handful of hours; the ingest_runs collection checkpoints per file so
# scaling up is incremental.
GHA_START=2020-06-01-00
GHA_END=2020-06-30-23

# ---------- Worker pool (IP-007, Stage 4) ----------

# Per-host concurrent analyze processes. Sized for the 16-vCPU / 16 GB
# fei-16-16-30 worker hosts (IP-010); drop to 2-4 on a laptop.
WORKER_CONCURRENCY=12

# Where IP-007 clones repos. Must have headroom for the largest repo ×
# WORKER_CONCURRENCY; not used by the ingest pipeline (IP-005 streams
# through memory).
SCRATCH_DIR=/scratch

# GitHub Personal Access Token for Stage 4 REST enrichment. Fine-grained
# PAT with "Public Repositories (read-only)" access is the recommended
# form (see docs/CONFIGURATION.md). Without it, the worker still runs
# but hits the 60/hour unauth rate limit almost immediately — leaving
# most repos without github_metadata populated.
# GITHUB_TOKEN=github_pat_...

# User-Agent sent on every GitHub API call so Cloudflare / GitHub abuse
# team can identify us. Update the email to your contact if you fork.
# GITHUB_USER_AGENT=oss-profanity/0.1 (jakub.dubec@stuba.sk)

# Per-call timeout for each git subprocess (clone / rev-list / checkout).
# Acts alongside PER_REPO_TIMEOUT_SEC as the outer envelope.
GIT_SUBPROCESS_TIMEOUT_SEC=300

# ---------- Filters + caps ----------

# Bot-author regex, case-insensitive. Extended in code (IP-005 _bot.py)
# with BIMAN-era named bots and the `[bot]` suffix; this env var is the
# operational override for per-run tuning.
BOT_REGEX=(bot|dependabot|renovate|github-actions|greenkeeper)

# Skip repos reported larger than this pre-clone (IP-007).
MAX_REPO_SIZE_MB=2048

# Hard cap per repo in Stage 4 (IP-007); exceeds → status=failed.
PER_REPO_TIMEOUT_SEC=600

# Stale-claim TTL for IP-001's `repos.claimed_at` reclamation.
STALE_CLAIM_TTL_MIN=20

# Top-N emoji glyph counter size on every doc (IP-003 / IP-005).
EMOJI_TOP_N=20

# Max profane commit messages kept per repo as talk material (IP-005).
SAMPLE_PROFANE_N=5

# ---------- Cohort sampling (IP-006, Stage 3) ----------

# Cohort A: top-N profane repos by `commit_stats.profanity_rate` desc.
# 750 is DRAFT §5.2's value. The live pool (June 2020) has ~10,232
# candidates — ~13.6× headroom above the default.
PROFANE_COHORT_SIZE=750

# Cohort B: commit-count-matched clean repos (profanity_hits == 0).
# Normally identical to PROFANE_COHORT_SIZE.
CLEAN_COHORT_SIZE=750

# Minimum `total_commits_in_window` for either cohort. Below this, the
# per-repo rate is too noisy to trust.
SAMPLING_MIN_COMMITS=20

# Log-spaced commit-count bins for stratified matching. CSV of
# strictly-monotonic ints; four bins (the default) produce intervals
# [20,50), [50,200), [200,1000), [1000,∞). See docs/COHORT.md for why
# bin-matching is the sampling strategy.
SAMPLING_COMMIT_BINS=20,50,200,1000
